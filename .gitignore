## Ignore Visual Studio / .NET temporary files, build results, and user settings

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Pp]ublish/
[Tt]est[Rr]esults/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Mono auto-generated files
mono_crash.*

# IDEs & Tooling
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
*.DotSettings.user
*.[Re]Sharper.user
_ReSharper*/
*.sln.iml

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# ASP.NET Core secrets and environment settings
appsettings.Development.json
appsettings.*.local.json
secrets.json

# NuGet
*.nupkg
*.snupkg
**/packages/
project.lock.json
project.assets.json

# Local environment
.env.local
.env.development.local